{
    "name": "cloudtasks/app",
    "description": "CloudTasks - A cloud-based to-do list web application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "mongodb/mongodb": "^2.0",
        "cloudinary/cloudinary_php": "^2.12",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "CloudTasks\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public",
        "create-indexes": "php scripts/create-indexes.php"
    }
}
